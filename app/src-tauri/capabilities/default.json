{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the app window, the viewer window and the tray popup",
  "windows": ["main", "viewer", "tray_popup"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://akoos.eu" },
        { "url": "https://www.buymeacoffee.com/akoos" },
        { "url": "https://www.photosforproton.eu" },
        { "url": "https://github.com/gitakoos/photos-desktop" }
      ]
    },
    "dialog:allow-open",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-fullscreen",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "core:window:allow-set-background-color"
  ]
}
